{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxbot:course-map:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "frameId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "mapEpoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "geometryId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cameraId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frozen": {
      "type": "boolean"
    },
    "cones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "radiusM": {
            "type": "number"
          },
          "observed": {
            "type": "boolean"
          },
          "errorBoundM": {
            "type": [
              "number",
              "null"
            ]
          },
          "sourceFrames": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$"
            },
            "maxItems": 128
          },
          "independentViews": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "radiusM",
          "observed",
          "errorBoundM",
          "sourceFrames",
          "independentViews"
        ]
      },
      "maxItems": 4
    },
    "qualityReport": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      },
      "maxItems": 32
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "frameId",
    "mapEpoch",
    "geometryId",
    "cameraId",
    "modelId",
    "frozen",
    "cones",
    "qualityReport"
  ]
}
