{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxbot:cone-image-observation:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "frameId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "timestampNs": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "clockDomain": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "box": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "maxItems": 4
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "visibleBase": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "maxItems": 16
    }
  },
  "required": [
    "schemaVersion",
    "frameId",
    "timestampNs",
    "clockDomain",
    "box",
    "confidence"
  ]
}
