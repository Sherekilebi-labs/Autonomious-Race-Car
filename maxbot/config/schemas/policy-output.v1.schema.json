{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxbot:policy-output:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "steeringDeg": {
      "type": "number"
    },
    "logicalPwm": {
      "type": "integer",
      "minimum": -255,
      "maximum": 255
    },
    "validUntilNs": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "sourceStateId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "sourceFrameId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      },
      "maxItems": 32
    }
  },
  "required": [
    "schemaVersion",
    "steeringDeg",
    "logicalPwm",
    "validUntilNs",
    "sourceStateId",
    "sourceFrameId",
    "diagnostics"
  ]
}
