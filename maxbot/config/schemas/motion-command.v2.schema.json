{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 2
    },
    "type": {
      "const": "command"
    },
    "boot": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "session": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issued_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mode": {
      "enum": [
        "STOP",
        "DISARM",
        "RESET",
        "ARM",
        "ARM_MANUAL",
        "DRIVE",
        "DRIVE_MANUAL",
        "ESTOP"
      ]
    },
    "steering_mdeg": {
      "type": "integer",
      "minimum": -65000,
      "maximum": 65000
    },
    "pwm": {
      "type": "integer",
      "minimum": -255,
      "maximum": 255
    },
    "source_state": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "source_frame": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "calibration_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mac": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "v",
    "type",
    "boot",
    "session",
    "epoch",
    "seq",
    "issued_ms",
    "expires_ms",
    "mode",
    "steering_mdeg",
    "pwm",
    "source_state",
    "source_frame",
    "calibration_id",
    "mac"
  ]
}
