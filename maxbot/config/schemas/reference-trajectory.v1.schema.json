{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxbot:reference-trajectory:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "referenceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mapEpoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "frameId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "calibrationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "geometryId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vehicleModelId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "planningParametersId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cameraId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sides": {
      "const": [
        -1,
        1,
        -1,
        1
      ]
    },
    "clearanceM": {
      "type": "number",
      "minimum": 0.15
    },
    "uncertaintyM": {
      "type": "number"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "s": {
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "yaw": {
            "type": "number"
          },
          "curvature": {
            "type": "number"
          },
          "speed": {
            "type": "number"
          }
        },
        "required": [
          "s",
          "x",
          "y",
          "yaw",
          "curvature",
          "speed"
        ]
      },
      "maxItems": 8192
    },
    "finishS": {
      "type": "number"
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
        },
        "feasible": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          },
          "maxItems": 32
        }
      },
      "required": [
        "version",
        "feasible",
        "diagnostics"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "referenceId",
    "mapEpoch",
    "frameId",
    "calibrationId",
    "geometryId",
    "vehicleModelId",
    "planningParametersId",
    "cameraId",
    "modelId",
    "sides",
    "clearanceM",
    "uncertaintyM",
    "samples",
    "finishS",
    "validator"
  ]
}
