{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxbot:trace-event:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "clockDomain": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
      },
      "maxItems": 16
    },
    "bootId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "mapEpoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "configId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stage": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$"
    },
    "timestampNs": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "lostEvents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "clockDomain",
    "eventId",
    "sourceIds",
    "bootId",
    "sessionId",
    "mapEpoch",
    "configId",
    "stage",
    "timestampNs",
    "lostEvents"
  ]
}
